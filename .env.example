# SignED Environment Configuration (Local XAMPP Setup)
# Rename or copy this file to .env: copy .env.example .env

# Database Configuration (XAMPP Defaults: user=root, pass=empty, db=sped_lms)
DB_HOST=localhost
DB_NAME=sped_lms
DB_USER=root
DB_PASS=

# Email Configuration (PHPMailer - Live Google SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="SignED SPED LMS"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/Signedd/public/auth/google/callback

# Security & Environment
ENCRYPTION_KEY=hnHrunsCXCD+ovtPLNk+XOEs36s6xOJ6eCIrCXSBvko=
APP_ENV=development

# Application Base URL (Change to http://localhost/Signedd/public or your custom virtual host)
APP_URL=http://localhost/Signedd/public

