# SPED LMS — Root .htaccess for Shared Hosting Compatibility
# Redirects all requests to the public/index.php front controller

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If request is not already pointing to the public folder, redirect to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
