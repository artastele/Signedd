# SignED Environment Configuration (Laragon Setup)
# Copy this file to .env: copy .env.laragon.example .env

# Database Configuration (Laragon MySQL: root, empty password, db=sped_lms)
DB_HOST=127.0.0.1
DB_NAME=sped_lms
DB_USER=root
DB_PASS=

# Application Base URL
# Laragon Virtual Host: http://signedd.test (automatically mapped to public/)
# Alternatively: http://localhost/Signedd/public
APP_URL=http://signedd.test

# Email Configuration (PHPMailer)
# Option A: Built-in Laragon Mailpit (Intercepts local emails - View inbox at http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@signedd.test
MAIL_FROM_NAME="SignED"

# Brevo Email API Configuration (Optional: send live emails via Brevo)
# Note: Comment out BREVO_API_KEY if you want to capture emails locally in Laragon Mailpit instead
BREVO_API_KEY=your_brevo_api_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://signedd.test/auth/google/callback

# SMS Gateway Configuration (Semaphore)
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=SignED

# Security & Environment
ENCRYPTION_KEY=base64:your_32_byte_base64_encoded_key_here=
APP_ENV=development
