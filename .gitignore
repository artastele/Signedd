# Environment variables
.env
.env.infinityfree
.env.test-server
.env.local
.env.production


# Uploaded files
public/uploads/*
!public/uploads/.gitkeep

# Logs
logs/*.log
!logs/.gitkeep

# Vendor dependencies (Composer)
vendor/
composer.lock

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.bak*
*.swp
*~

# Temporary scratch and debug scripts
scratch/
check_live_db.php
deploy_sync.php
public/db_reset_tool.php

# Large archives and extracted test folders
*.zip
signedtest_extracted/

# Test spreadsheets and data
*.xlsx
*.csv

# Database dumps and backups (preserve versioned migrations and schema)
*.sql
!config/v*.sql
!config/schema.sql
!config/manual_migration_*.sql
!config/insert_demo_enrollments.sql
!database.sql
backups/
