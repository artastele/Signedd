# SignED Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_NAME=sped_lms
DB_USER=root
DB_PASS=

# Email Configuration (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username_here
MAIL_PASSWORD=your_mail_password_here
MAIL_FROM_ADDRESS=your_mail_from_address_here
MAIL_FROM_NAME="SignED"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/Signedd/public/auth/google/callback

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
APP_ENV=development

# Application
APP_URL=http://localhost/Signedd/public

# Claude AI Configuration (Optional - for PDSP AI auto-fill feature)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=
